# ─────────────────────────────────────────────────────────────
# AdsRobotic — environment configuration
# Copy to `.env` and fill in. Never commit real secrets.
# Validated by @adsrobotic/config (packages/config/src/env.ts).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# Core
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL). DIRECT_URL is used for migrations when the primary
# URL points at a pooled connection (e.g. Neon / PgBouncer).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adsrobotic
DIRECT_URL=

# Redis (background jobs, campaign monitoring, rate limiting)
REDIS_URL=redis://localhost:6379

# Security
# SESSION_SECRET: >= 32 chars. TOKEN_ENCRYPTION_KEY encrypts channel OAuth
# tokens at rest (base64 of 32 random bytes recommended).
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
TOKEN_ENCRYPTION_KEY=change-me-base64-32-bytes

# Object storage (creative assets, generated landing-page media) — optional
# until asset features land.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_SECRET=

# ─── AI orchestration layer (Business Brain, Strategist, Creative, Guardian) ───
# Provider-agnostic. `local` runs on-platform with no external calls (default).
# `claude` / `openrouter` are config-gated drop-ins.
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_BASE_URL=

# ─── Advertising channel connectors ───
# Each channel adapter reads its own credentials lazily when connected.

# Google Ads — a LIVE adapter. Needs a Google Cloud OAuth client AND an approved
# Google Ads API developer token. OAuth redirect to whitelist:
#   ${NEXT_PUBLIC_APP_URL}/api/v1/channels/google/callback
# LOGIN_CUSTOMER_ID is your MCC/manager account id (digits only), if using one.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v18

# Meta (Facebook & Instagram) — the first LIVE adapter. Create a Meta app with
# the Marketing API, then set these. The OAuth redirect URI to whitelist is:
#   ${NEXT_PUBLIC_APP_URL}/api/v1/channels/meta/callback
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_GRAPH_VERSION=v21.0

# TikTok Ads — a LIVE adapter. Create a TikTok for Business developer app with
# the Marketing API. OAuth redirect to whitelist:
#   ${NEXT_PUBLIC_APP_URL}/api/v1/channels/tiktok/callback
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_API_VERSION=v1.3

# WhatsApp Business (lead destination)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
